<section class="mx-auto max-w-6xl px-5 py-14 text-center sm:px-10">
  <h1 class="animate-fade-up text-4xl font-extrabold sm:text-5xl">Campus Reels</h1>
  <p class="mt-3 animate-fade-up text-pulse-muted [animation-delay:150ms]">Watch what's happening around campus.</p>

  <div class="mx-auto mt-10 w-[min(360px,100%)] animate-fade-up rounded-3xl bg-gradient-to-br from-pulse-accent via-pulse-accent2 to-pink-500 bg-[length:200%_200%] p-0.5 shadow-2xl shadow-pulse-accent2/20 [animation-delay:300ms]">
    <div class="aspect-[9/16] overflow-hidden rounded-[22px] bg-pulse-surface">
      <iframe id="reel" class="block h-full w-full border-0" title="Instagram reel 1" src="https://www.instagram.com/reel/De9csE3C7Y-/embed" allowfullscreen></iframe>
    </div>
  </div>

  <p id="reel-count" class="mt-6 text-pulse-muted" aria-live="polite">Reel 1 of 2</p>
  <div class="mt-4 flex justify-center gap-3">
    <button id="previous" type="button" class="btn-primary" disabled>&larr; Previous</button>
    <button id="next" type="button" class="btn-primary">Next &rarr;</button>
  </div>
</section>
