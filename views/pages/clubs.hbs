<section class="mx-auto max-w-6xl px-5 py-16 sm:px-10 sm:py-20" aria-labelledby="clubs-heading">
  <h1 id="clubs-heading" class="animate-fade-up text-4xl font-extrabold sm:text-6xl">Find your people.</h1>
  <p class="mt-4 max-w-xl animate-fade-up text-lg text-pulse-muted [animation-delay:150ms]">
    Explore the clubs that make our campus a little more yours.
  </p>

  <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
    {{#each clubs}}
    <div class="reveal" style="transition-delay: {{stagger @index}}">
      <article class="group flex min-h-32 flex-col justify-center rounded-xl border border-pulse-border bg-gradient-to-br from-[#171e30] to-pulse-surface p-5 transition duration-300 hover:-translate-y-1 hover:border-pulse-accent2 hover:shadow-xl hover:shadow-pulse-accent2/10 sm:min-h-40">
        <span class="mb-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-pulse-accent2">{{category}}</span>
        <h2 class="text-sm font-bold tracking-wide transition-colors duration-300 group-hover:text-pulse-accent2 sm:text-lg">{{name}}</h2>
        <p class="mt-2 text-xs leading-relaxed text-pulse-muted sm:text-sm">{{blurb}}</p>
        <span class="mt-3 text-[10px] font-medium uppercase tracking-wider text-pulse-muted">{{flagshipEvent}}</span>
      </article>
    </div>
    {{/each}}
  </div>
</section>
