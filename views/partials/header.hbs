<header id="site-nav" class="site-header sticky top-0 z-50 border-b border-white/10 bg-pulse-bg/80 backdrop-blur-xl transition-shadow duration-300">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 sm:px-10">

    <a href="/" class="group flex shrink-0 items-center gap-2.5 text-xl font-extrabold tracking-wide" aria-label="{{siteName}} home">
      <span class="relative flex h-3 w-3">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-pulse-accent opacity-75"></span>
        <span class="relative inline-flex h-3 w-3 animate-heartbeat rounded-full bg-pulse-accent"></span>
      </span>
      <span class="transition-colors duration-300 group-hover:text-pulse-accent2">{{siteName}}</span>
    </a>

    <button id="nav-hamburger" type="button" class="group flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-lg md:hidden" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-menu">
      <span class="h-0.5 w-6 rounded bg-white transition duration-300 group-aria-expanded:translate-y-2 group-aria-expanded:rotate-45"></span>
      <span class="h-0.5 w-6 rounded bg-white transition duration-300 group-aria-expanded:opacity-0"></span>
      <span class="h-0.5 w-6 rounded bg-white transition duration-300 group-aria-expanded:-translate-y-2 group-aria-expanded:-rotate-45"></span>
    </button>

    <nav id="nav-menu" class="nav-panel" aria-label="Primary">
      <ul class="flex flex-col gap-1 md:flex-row md:items-center md:gap-7">
        {{#each navLinks}}
        <li><a href="{{href}}" class="nav-link{{#if active}} nav-link-active{{/if}}"{{#if active}} aria-current="page"{{/if}}>{{label}}</a></li>
        {{/each}}
      </ul>
      <div class="flex items-center gap-4">
        <a href="/index/signin.html" class="nav-link{{#if (eq currentPath '/index/signin.html')}} nav-link-active{{/if}}">Sign in</a>
        <a href="/index/signup.html" class="btn-primary !px-5 !py-2">Sign up</a>
      </div>
    </nav>

  </div>
</header>
